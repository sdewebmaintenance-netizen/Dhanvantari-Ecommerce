generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique @db.VarChar(32)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model User {
  id              Int               @id @default(autoincrement())
  username        String?
  email           String?           @unique
  isAdmin         Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  display_picture String?
  password        String?
  phone           String?           @unique
  GSTIN           String?
  Cart            Cart[]
  loginHistory    LoginHistory[]
  orders          Order[]
  reviews         Review[]
  ShippingAddress ShippingAddress[]
}

model LoginHistory {
  id          Int         @id @default(autoincrement())
  userId      Int
  loginMethod LoginMethod
  loginTime   DateTime    @default(now())
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "LoginHistory_userId_fkey")
}

model Product {
  id              Int            @id @default(autoincrement())
  name            String
  brand           String
  category_id     Int
  description     String         @db.LongText
  rating          Float          @default(0)
  numReviews      Int            @default(0)
  price           Float          @default(0)
  countInStock    Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  inco_term_id    Int?
  port_id         Int?
  productType     ProductType?
  variant         String?
  weight          Int            @default(0)
  CGST            Float?
  SGST            Float?
  hsnSac          Int?
  isVisible       Boolean        @default(true)
  IGST            Float?
  moq             Float          @default(1)
  discount_id     Int?
  pcode           String?
  Cart            Cart[]
  orderItems      OrderItem[]
  ProductCategory Category       @relation(fields: [category_id], references: [id], onDelete: Cascade)
  ProductDiscount Discount?      @relation(fields: [discount_id], references: [id])
  ProductIncoTerm IncoTerm?      @relation(fields: [inco_term_id], references: [id])
  ProductPort     Port?          @relation(fields: [port_id], references: [id])
  ProductImages   ProductImage[]
  reviews         Review[]

  @@index([category_id], map: "Product_category_id_fkey")
  @@index([discount_id], map: "Product_discount_id_fkey")
  @@index([inco_term_id], map: "Product_inco_term_id_fkey")
  @@index([port_id], map: "Product_port_id_fkey")
}

model Cart {
  id                  Int              @id @default(autoincrement())
  product_id          Int
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  quantity            Int
  user_id             Int
  shipping_address_id Int?
  Products            Product          @relation(fields: [product_id], references: [id], onDelete: Cascade)
  CartShippingAddress ShippingAddress? @relation(fields: [shipping_address_id], references: [id], onDelete: Cascade)
  CartUser            User             @relation(fields: [user_id], references: [id])

  @@index([product_id], map: "Cart_product_id_fkey")
  @@index([shipping_address_id], map: "Cart_shipping_address_id_fkey")
  @@index([user_id], map: "Cart_user_id_fkey")
}

model IncoTerm {
  id             Int       @id @default(autoincrement())
  inco_term_name String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  Products       Product[]
}

model Port {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  country   String
  district  String
  Products  Product[]
}

model ProductImage {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())
  product_id Int
  updatedAt  DateTime @updatedAt
  image_url  String
  public_id  String
  product    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id], map: "ProductImage_product_id_fkey")
}

model Review {
  id            Int      @id @default(autoincrement())
  name          String
  rating        Float
  comment       String
  user_id       Int
  product_id    Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  ReviewProduct Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  ReviewUser    User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([product_id], map: "Review_product_id_fkey")
  @@index([user_id], map: "Review_user_id_fkey")
}

model OrderItem {
  id               Int       @id @default(autoincrement())
  name             String
  qty              Int
  product_id       Int
  order_id         Int
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  discount_id      Int?
  OrderDiscount    Discount? @relation(fields: [discount_id], references: [id], onDelete: Cascade)
  OrdersRecord     Order     @relation(fields: [order_id], references: [id], onDelete: Cascade)
  OrderItemProduct Product   @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([discount_id], map: "OrderItem_discount_id_fkey")
  @@index([order_id], map: "OrderItem_order_id_fkey")
  @@index([product_id], map: "OrderItem_product_id_fkey")
}

model Order {
  id                   Int             @id @default(autoincrement())
  user_id              Int
  shippingAddress_id   Int
  paymentMethod        String
  paymentResult_id     Int?
  totalPrice           Float           @default(0)
  isPaid               Boolean         @default(false)
  paidAt               DateTime
  isDelivered          Boolean         @default(false)
  deliveredAt          DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  CGST                 Float           @default(0)
  SGST                 Float           @default(0)
  itemsUnitPrice       Float           @default(0)
  IGST                 Float           @default(0)
  invoicePath          String?
  OrderPaymentResult   PaymentResult?  @relation(fields: [paymentResult_id], references: [id], onDelete: Cascade)
  OrderShippingAddress ShippingAddress @relation(fields: [shippingAddress_id], references: [id], onDelete: Cascade)
  OrderUser            User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  orderItems           OrderItem[]

  @@index([paymentResult_id], map: "Order_paymentResult_id_fkey")
  @@index([shippingAddress_id], map: "Order_shippingAddress_id_fkey")
  @@index([user_id], map: "Order_user_id_fkey")
}

model Discount {
  id               Int         @id @default(autoincrement())
  qty              Int
  pricetobereduced Float
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  OrderItem        OrderItem[]
  Products         Product[]
}

model ShippingAddress {
  id                   Int      @id @default(autoincrement())
  country              String
  state                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  addressLine1         String?
  addressLine2         String?
  contactNumber        String?
  deliveryCountry      String?
  deliveryDistrict     String?
  deliveryPincode      String?
  deliveryState        String?
  district             String?
  gstin                String?
  pincode              String?
  transportation       String?
  vehicleNumber        String?
  user_id              Int?
  customerName         String?
  deliveryAddressLine1 String?
  deliveryAddressLine2 String?
  Cart                 Cart[]
  Order                Order[]
  ShippingAddressUser  User?    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "ShippingAddress_user_id_fkey")
}

model PaymentResult {
  id                 Int      @id @default(autoincrement())
  transactionId      String
  status             String
  updateTime         DateTime @default(now())
  emailAddress       String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  OrderPaymentResult Order[]
}

enum LoginMethod {
  GOOGLE
  PHONE
}

enum ProductType {
  WHOLESALE
  EXPORT
}
